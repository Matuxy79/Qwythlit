# CLS RAG+CAG — temporary fast retrieval mode.
#
# These defaults keep every LLM augmentation/generation path off and force direct
# keyword retrieval. Flip both to 0 when you want the semantic+carrier path back.
export CLS_RETRIEVAL_ONLY=1
export CLS_KEYWORD_ONLY=1

# CLS RAG+CAG — config for the generative "💬 Answer with gpt-oss-120b" answer.
#
# OpenRouter · openai/gpt-oss-120b is now the DEFAULT carrier and the answer is ON by
# default — the app already knows the URL and model, so plug-and-play is just your key:
#
#   1. cp cls.env.example cls.env
#   2. paste your OpenRouter key on the CLS_DLLM_API_KEY line below
#   3. ./scripts/launch_cls.sh   (it auto-sources cls.env if present; cls.env is gitignored)
#
# Streamlit users can configure OpenRouter directly in the sidebar.

# --- OpenRouter (default carrier) -----------------------------------------------------
# URL + model match the app defaults; you only NEED to paste your key.
export CLS_DLLM_API_KEY=
# export CLS_DLLM_API_URL=https://openrouter.ai/api/v1
# export CLS_DLLM_MODEL=openai/gpt-oss-120b

# --- Railway Streamlit app ------------------------------------------------------
# railway.toml serves Full App + Ask Lane at the public URL using the embedded
# backend (CLS_USE_API=0). Attach a volume and retain the same CLS_CHROMA_DIR
# across deployments to preserve the index. Empty stores bootstrap on first use.
# export CLS_CHROMA_DIR=/data/chroma_store
# export CLS_BOOTSTRAP_CORPUS=1

# Optional separate API: deploy with /railway.api.toml, then point a local UI
# at that API service's URL, not the Streamlit service's URL.
# export CLS_USE_API=1
# export CLS_API_URL=https://your-api-service.up.railway.app
