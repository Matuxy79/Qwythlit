# John's Light Source (JLS) RAG+CAG — configuration.
#
# Defaults: generation on (the sidebar "Generate via OpenRouter" toggle governs),
# deterministic keyword ranking on:
export JLS_KEYWORD_ONLY=1
# Hard retrieval-only for headless paths (optional override):
# export JLS_RETRIEVAL_ONLY=1

# Generative carrier configuration (OpenRouter openai/gpt-oss-120b by default).
# To enable generative carrier:
#   1. cp jls.env.example jls.env
#   2. Paste your OpenRouter key on the JLS_DLLM_API_KEY line below
#   3. ./scripts/launch_jls.sh (auto-sources jls.env if present; jls.env is gitignored)

# --- OpenRouter (default carrier) -----------------------------------------------------
export JLS_DLLM_API_KEY=
# export JLS_DLLM_API_URL=https://openrouter.ai/api/v1
# export JLS_DLLM_MODEL=openai/gpt-oss-120b

# --- Railway Streamlit app ------------------------------------------------------
# railway.toml serves Full App + Ask Lane at the public URL using the embedded
# backend (JLS_USE_API=0). Attach a volume and retain JLS_CHROMA_DIR across deployments.
# export JLS_CHROMA_DIR=/data/chroma_store
# export JLS_BOOTSTRAP_CORPUS=0

# Optional separate API:
# export JLS_USE_API=1
# export JLS_API_URL=https://your-api-service.up.railway.app
